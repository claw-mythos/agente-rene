{
  "mcpServers": {
    "grok": {
      "command": "node",
      "args": [
        "/home/box/.hermes/agente-rene/backend-sdk-claude/mcp-servers/grok-mcp.mjs"
      ]
    },
    "wa-allowlist": {
      "command": "node",
      "args": [
        "/home/box/.hermes/agente-rene/backend-sdk-claude/mcp-servers/wa-allowlist-mcp.mjs"
      ],
      "env": {
        "WA_ALLOWLIST_PIN": ""
      }
    },
    "buffer": {
      "type": "http",
      "url": "https://mcp.buffer.com/mcp",
      "headers": {
        "Authorization": "Bearer ${BUFFER_API_KEY_DM}"
      }
    }
  }
}
