#!/usr/bin/env bash
# pre-push — defesa local: roda a suíte + probe do better-sqlite3 + audit-gate
# antes de deixar o push sair. O deploy real é git no próprio host, então este
# hook é a última linha antes de código quebrado chegar na produção.
#
# Instalar (uma vez):
#   ln -sf ../../backend-sdk-claude/scripts/pre-push .git/hooks/pre-push
set -euo pipefail

REAL_SCRIPT="$(readlink -f "$0" 2>/dev/null || realpath "$0" 2>/dev/null || echo "$0")"
SCRIPT_DIR="$(cd "$(dirname "$REAL_SCRIPT")" && pwd)"
ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
cd "$ROOT"

NODE_BIN="${CLAUDE_NODE_BIN:-}"
if [ -z "$NODE_BIN" ] && [ -f .env ]; then
  NODE_BIN="$(grep -m1 '^CLAUDE_NODE_BIN=' .env | cut -d= -f2- || true)"
fi
NODE_BIN="${NODE_BIN:-node}"

echo "[pre-push] better-sqlite3 ABI probe…"
"$NODE_BIN" -e 'new (require("better-sqlite3"))(":memory:")' \
  || { echo "[pre-push] FAIL: better-sqlite3 não carrega — rode bash scripts/preflight.sh"; exit 1; }

echo "[pre-push] npm test…"
bash scripts/run-tests.sh --silent

echo "[pre-push] audit-gate…"
"$NODE_BIN" scripts/audit-gate.js

echo "[pre-push] ok — push liberado"
