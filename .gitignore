# Postman — arquivos voláteis do monitor (logs, dedup state)
postman/.monitor.log
postman/.monitor.last-run
postman/.monitor.last-alert
# Postman performance baselines — JSONs por data são regerados
postman/baselines/*.json
!postman/baselines/.gitkeep
# Postman perf-reports e security-reports (autocannon JSON, ZAP HTML/JSON)
postman/perf-reports/*.json
postman/security-reports/*.html
postman/security-reports/*.json
# Monitor opensign (debounce/log)
postman/.monitor-opensign.log
postman/.monitor-opensign.last-run
postman/.monitor-opensign.last-alert
